# Copy this file to prj.local.conf and fill in your own network.
#
#   cp prj.local.conf.example prj.local.conf
#   west build -b esp32_devkitc_procpu -- -DEXTRA_CONF_FILE=prj.local.conf
#
# prj.local.conf is git-ignored. Never commit real credentials.
# (On Zephyr < 3.4 the flag is -DOVERLAY_CONFIG=prj.local.conf instead.)

CONFIG_WIFI_SSID="your-ssid"
CONFIG_WIFI_PSK="your-password"
